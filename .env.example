# ---------------------------------------------------------------- database
# Postgres 15 or later. See docs/DEPLOY.md.
DATABASE_URL="postgresql://qi:qi@localhost:5432/qi_agent?schema=public"

# ---------------------------------------------------------------- llm
# One of: mock | anthropic | azure-openai | openai-compatible
# `mock` is the default and requires no credentials. Every feature is
# developed and tested against it. See docs/ADR/0002-llm-provider-adapter.md.
LLM_PROVIDER="mock"

# provider=anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# provider=azure-openai
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-10-21"

# provider=openai-compatible — an internal gateway with an arbitrary base URL.
# This is the likely production path where the enclave has no outbound HTTPS
# to a public LLM endpoint (Q9).
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL=""

# ---------------------------------------------------------------- auth
# Development: resolve the current user by email from the seeded set.
DEV_USER_EMAIL="chair@example.edu"
# Production without SSO: gate the whole app behind one shared passcode.
# Leave empty in development. See docs/SSO.md.
APP_PASSCODE=""

# ---------------------------------------------------------------- mail
# One of: log | smtp | resend. Default `log` records the rendered message to
# the audit table and sends nothing. A demo must never send mail.
MAIL_PROVIDER="log"
MAIL_FROM="qi-agent@example.edu"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""

# ---------------------------------------------------------------- jobs
# Shared secret for the protected job route invoked by cron (ADR-0001).
JOB_SECRET="change-me-in-production"
